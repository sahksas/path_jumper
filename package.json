{
  "name": "path-jumper",
  "version": "1.0.0",
  "description": "Chrome extension that replaces the current URL path with the clipboard content while keeping the active tab's origin.",
  "scripts": {
    "watch": "webpack --config webpack/webpack.dev.js --watch",
    "build": "webpack --config webpack/webpack.prod.js",
    "clean": "rimraf dist",
    "test": "npx jest",
    "format": "prettier --write ."
  },
  "author": "sahksas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sahksas/path-jumper.git"
  },
  "devDependencies": {
    "@types/chrome": "0.1.36",
    "@types/jest": "^30.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "glob": "^13.0.1",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  }
}
